+@pytest.mark.asyncio
+async def test_retired_native_watcher_cannot_publish_status_for_replacement(
+    tmp_path: Path,
+) -> None:
+    """Queued and late old-pane edges cannot settle a replacement's turn."""
+    old_capture, new_capture = _WatcherCapture(), _WatcherCapture()
+    old = _make_capturing_instance(tmp_path, old_capture, name="claude", session_key="main")
+    new = _make_capturing_instance(tmp_path, new_capture, name="claude", session_key="main")
+    terminals = _LaunchReturningRegistry(old)
+    registry = SessionResourceRegistry(terminal_registry=terminals)
+    statuses = []
+    registry.set_session_status_publisher(lambda sid, status, reason=None: statuses.append(status))
+    for instance in (old, new):
+        terminals._instance = instance
+        await registry.launch_required_terminal(
+            session_id="conv_fallback",
+            terminal_name="claude",
+            session_key="main",
+            spec=_claude_terminal_spec(tmp_path),
+            resource_role=CLAUDE_NATIVE_TERMINAL_ROLE,
+        )
+        if instance is old:
+            old_capture.on_idle()  # Queued before the replacement takes ownership.
+    new_capture.on_activity()
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+    old_capture.on_idle()  # The retired daemon thread is still draining callbacks.
+    await asyncio.sleep(0)
+    assert statuses == ["running"]
+    new_capture.on_idle()
+    await asyncio.sleep(0)
+    assert statuses == ["running", "idle"]
