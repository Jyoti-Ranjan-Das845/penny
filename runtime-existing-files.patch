+def _parse_executor_fallbacks(raw: object) -> list[ExecutorFallback]:
+    """Parse native backup candidates without accepting permission overrides."""
+    if raw is None:
+        return []
+    if not isinstance(raw, list) or len(raw) > 2:
+        raise OmnigentError(
+            "executor.fallbacks must be a list of at most two backups",
+            code=ErrorCode.INVALID_INPUT,
+        )
+    candidates: list[ExecutorFallback] = []
+    for index, item in enumerate(raw):
+        path = f"executor.fallbacks[{index}]"
+        if not isinstance(item, dict) or set(item) - {"model", "harness", "reasoning_effort"}:
+            raise OmnigentError(
+                f"{path} accepts only model, harness and reasoning_effort",
+                code=ErrorCode.INVALID_INPUT,
+            )
+        model, harness, effort = (
+            item.get("model"),
+            item.get("harness"),
+            item.get("reasoning_effort"),
+        )
+        if not isinstance(model, str) or not model.strip() or any(c.isspace() for c in model):
+            raise OmnigentError(
+                f"{path}.model must be a nonempty model ID", code=ErrorCode.INVALID_INPUT
+            )
+        if harness not in ("codex-native", "claude-native"):
+            raise OmnigentError(
+                f"{path}.harness must be codex-native or claude-native",
+                code=ErrorCode.INVALID_INPUT,
+            )
+        if effort is not None and not isinstance(effort, str):
+            raise OmnigentError(
+                f"{path}.reasoning_effort must be a string", code=ErrorCode.INVALID_INPUT
+            )
+        candidates.append(ExecutorFallback(model, str(harness), effort))
+    return candidates
