+def _validate_executor_fallbacks(spec: AgentSpec, result: ValidationResult) -> None:
+    """Require a bounded, explicit chain using supported native executors."""
+    executor = spec.executor
+    if not executor.fallbacks:
+        return
+    path = "executor.fallbacks"
+    if executor.type != "omnigent" or executor.harness_kind not in (
+        "codex-native",
+        "claude-native",
+    ):
+        result.add(path, "requires a codex-native or claude-native primary executor")
+    if not executor.model:
+        result.add(path, "requires an explicit primary executor.model")
+    if len(executor.fallbacks) > 2:
+        result.add(path, "supports at most two backups")
+    if (
+        executor.auth is not None
+        or executor.connection is not None
+        or executor.profile
+        or executor.config.get("profile")
+    ):
+        result.add(
+            path,
+            "requires host-managed native credentials, "
+            "without executor auth, connection or profile",
+        )
+    seen = {(executor.harness_kind, executor.model)}
+    for index, candidate in enumerate(executor.fallbacks):
+        entry_path = f"{path}[{index}]"
+        if not candidate.model or any(c.isspace() for c in candidate.model):
+            result.add(entry_path + ".model", "must be a nonempty model ID")
+        if candidate.harness not in ("codex-native", "claude-native"):
+            result.add(entry_path + ".harness", "must be codex-native or claude-native")
+        key = (candidate.harness, candidate.model)
+        if key in seen:
+            result.add(entry_path, "duplicates the primary or an earlier backup")
+        seen.add(key)
+        if candidate.reasoning_effort is not None:
+            try:
+                validate_effort(
+                    candidate.reasoning_effort,
+                    entry_path + ".reasoning_effort",
+                    efforts_for_harness(candidate.harness) or frozenset(),
+                )
+            except ValueError as exc:
+                result.add(entry_path + ".reasoning_effort", str(exc))
+
